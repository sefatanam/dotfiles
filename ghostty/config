#theme = "kanso-zen"
theme = "Gruvbox Material Dark"

# ─── CLIPBOARD ───
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# ─── CURSOR (Optimized for Neovim) ───
cursor-style = block
cursor-style-blink = false

# ─── FONT (Performance + Readability) ───
font-size = 16

# ─── JetBrainsMono Font Settings ───
font-thicken = false
#font-family = "JetBrainsMono Nerd Font Propo"
font-family = "Maple Mono NF"
adjust-cell-height = 15


# ─── Fantasque Font Settings ───
# font-family = "Fantasque Sans Mono"
# font-thicken = false
# adjust-cell-height = 0%
# adjust-cell-height = 15

# ─── SpaceMono Font Settings ───
# font-family = "Space Mono"
# font-family = "JetBrainsMono Nerd Font Propo"
# font-thicken = true
# adjust-cell-height = 16

# ─── WINDOW (Maximize Screen Real Estate) ───
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-padding-color = background
window-save-state = always
window-colorspace = display-p3
window-height = 180
window-width = 220
window-step-resize = true
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
confirm-close-surface = false

# ─── PERFORMANCE SETTINGS ───
background-blur-radius = 0
background-opacity = 1.0
custom-shader-animation = false
unfocused-split-opacity = 1.0

# ─── INPUT LATENCY ───
mouse-hide-while-typing = true
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# ─── LINKS ───
link-url = true

# ─── AI AGENT SUPPORT (Claude, etc.) ───
scrollback-limit = 50000
mouse-scroll-multiplier = 3

# ─── TMUX INTEGRATION ───
# Disable shell integration (tmux handles this)
shell-integration = none
# Proper TERM for true colors in tmux
term = xterm-ghostty

