macos-icon = xray
#theme = dark:"Github Dark Dimmed",light:"Github Light Default"
# theme = dark:"Earthsong",light:"Github Light Default"
theme = dark:"Gruvbox Material Dark",light:"Github Light Default"
# ─── CLIPBOARD ───
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# ─── CURSOR (Optimized for Neovim) ───
cursor-style = block
cursor-style-blink = false
focus-follows-mouse = true
mouse-hide-while-typing = true

# ─── FONT (Performance + Readability) ───
font-size = 16

# ─── Font Settings ───
# font-family = "IBM Plex Mono"
# font-style = Regular
# font-family-bold = "IBM Plex Mono"
# font-style-bold = Bold
# font-family-italic = "IBM Plex Mono"
# font-style-italic = Italic
# font-family-bold-italic = "IBM Plex Mono"
# font-style-bold-italic = Bold Italic
#

font-family = "Maple Mono NF"
font-style = Regular
font-family-bold = "IBM Plex Mono"
font-style-bold = Bold
font-family-italic = "IBM Plex Mono"
font-style-italic = Italic
font-family-bold-italic = "IBM Plex Mono"
font-style-bold-italic = Bold Italic

font-thicken = true
font-thicken-strength = 0
adjust-cell-height = 12
font-feature = -liga

# ─── WINDOW (Maximize Screen Real Estate) ───
window-padding-x = 2
window-padding-y = 4
window-padding-balance = true
# window-padding-color = background
window-save-state = always
window-colorspace = display-p3
window-height = 180
window-width = 220
window-step-resize = true
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
confirm-close-surface = false

# ─── PERFORMANCE SETTINGS ───
background-blur-radius = 0
background-opacity = 1.0
custom-shader-animation = false
unfocused-split-opacity = 1.0

# ─── INPUT LATENCY ───
mouse-hide-while-typing = true
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# ─── LINKS ───
link-url = true

# ─── AI AGENT SUPPORT (Claude, etc.) ───
scrollback-limit = 100000000
mouse-scroll-multiplier = 3

# ─── TMUX INTEGRATION ───
# Disable shell integration (tmux handles this)
shell-integration = none
# Proper TERM for true colors in tmux
term = xterm-ghostty

# tmux integration - send save-buffer command
keybind = cmd+s=text:\x01\x73

# tmux prefix to toggle zoom on current pane
keybind = cmd+b=text:\x01\x7a
