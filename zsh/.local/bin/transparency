#!/bin/bash
# The one switch for transparent mode (see CONTEXT.md).
#
#   transparency on | off | toggle    set it, then update what's running
#   transparency [status]             print on/off
#
# State is one word in $XDG_STATE_HOME/transparent-mode (default off when missing).
# Each tool reads it its own way:
#   * Ghostty can't read the state, so this writes a generated include beside its
#     config (gitignored) and asks Ghostty to reload over AppleScript. On macOS,
#     Ghostty only applies a background-opacity change after a full restart.
#   * Neovim watches the state file and re-applies its colorscheme (config/transparency.lua).
#   * tmux needs nothing: its backgrounds are `default`, so Ghostty shows through.
#
# The "on" look is defined here and nowhere else.

set -uo pipefail

TRANSPARENCY_OPACITY="0.85"
TRANSPARENCY_BLUR="20"

transparency_state_file() { echo "${XDG_STATE_HOME:-$HOME/.local/state}/transparent-mode"; }
transparency_ghostty_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/transparent-mode.conf"; }

# Anything but a first line of exactly "on" is off, so a missing or corrupt file is
# the opaque look a fresh machine starts with.
transparency_read_state() {
    local first=""
    [ -r "$(transparency_state_file)" ] && IFS= read -r first < "$(transparency_state_file)"
    [ "$first" = "on" ] && echo on || echo off
}

# transparency_next_state <current> <on|off|toggle>
transparency_next_state() {
    case "$2" in
        on|off) echo "$2" ;;
        toggle) [ "$1" = "on" ] && echo off || echo on ;;
        *) echo "transparency: unknown argument '$2' (use on, off, toggle or status)" >&2; return 1 ;;
    esac
}

# transparency_render_ghostty <on|off>
transparency_render_ghostty() {
    local opacity="1.0" blur="0"
    if [ "$1" = "on" ]; then opacity="$TRANSPARENCY_OPACITY" blur="$TRANSPARENCY_BLUR"; fi
    cat <<EOF
# Generated by \`transparency\` - do not edit; run \`transparency on|off\` instead.
background-opacity = $opacity
background-blur-radius = $blur
unfocused-split-opacity = 1.0
EOF
}

# transparency_write_atomically <path>  (content on stdin) - readers watching the file never see
# it half-written.
transparency_write_atomically() {
    local tmp="$1.tmp.$$"
    mkdir -p "$(dirname "$1")" && cat > "$tmp" && mv -f "$tmp" "$1"
}

transparency_reload_ghostty() {
    [ -n "${TRANSPARENCY_NO_RELOAD:-}" ] && return 0
    command -v osascript >/dev/null 2>&1 || return 0
    osascript >/dev/null 2>&1 <<'EOF' || echo "transparency: couldn't reload Ghostty (press its reload_config keybind)" >&2
if application "Ghostty" is running then
    tell application "Ghostty"
        if (count of terminals) > 0 then perform action "reload_config" on first terminal
    end tell
end if
EOF
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "transparency: restart Ghostty (Cmd+Q, reopen) to apply - macOS can't change its opacity live" >&2
    fi
}

transparency_main() {
    local arg="${1:-status}" next
    if [ "$arg" = "status" ]; then
        transparency_read_state
        return 0
    fi
    next="$(transparency_next_state "$(transparency_read_state)" "$arg")" || return 1
    echo "$next" | transparency_write_atomically "$(transparency_state_file)" || return 1
    transparency_render_ghostty "$next" | transparency_write_atomically "$(transparency_ghostty_file)" || return 1
    transparency_reload_ghostty
    echo "transparent mode: $next"
}

if [ -z "${TRANSPARENCY_TESTING:-}" ]; then
    transparency_main "$@"
fi
