{
  "name": "custom-snippets",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": [
          "tex"
        ],
        "path": "./snippets/latex/bibtex.json"
      },
      {
        "language": [
          "tex"
        ],
        "path": "./snippets/latex/latex-snippets.json"
      },
      {
        "language": [
          "tex"
        ],
        "path": "./snippets/latex/vscode-latex-snippets.json"
      },
      {
        "language": [
          "norg"
        ],
        "path": "./snippets/norg.json"
      },
      {
        "language": [
          "all"
        ],
        "path": "./snippets/global.json"
      }
    ]
  }
}
