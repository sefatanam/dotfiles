  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gpt-oss:120b-cloud": {
          "name": "gpt-oss:120b-cloud"
        },
        "kimi-k2.5:cloud": {
          "name": "kimi-k2.5:cloud"
        }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Omniroute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": ""
      },
      "models": {
        "cc/claude-fable-5": {
          "name": "cc/claude-fable-5"
        },
        "cc/claude-opus-4-7": {
          "name": "cc/claude-opus-4-7"
        },
        "cc/claude-sonnet-5": {
